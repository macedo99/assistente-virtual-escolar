<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Conversa com ' + conversa.usuario_nome }) %>
</head>
<body class="flex min-h-screen flex-col">
  <%- include('partials/topo', { atendente, ativo: 'conversas' }) %>

  <main class="pagina flex w-full max-w-4xl flex-1 flex-col">
    <a href="/" class="mb-4 inline-flex w-fit items-center gap-1 text-sm font-medium text-slate-500 hover:text-slate-800"><%- include('partials/icone', { nome: 'voltar' }) %> Conversas</a>

    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span class="grid size-11 place-items-center rounded-full bg-indigo-100 text-base font-semibold text-indigo-700"><%= String(conversa.usuario_nome || '?').trim().charAt(0).toUpperCase() %></span>
      <div class="min-w-0">
        <h1 class="truncate"><%= conversa.usuario_nome %></h1>
        <p class="text-sm capitalize text-slate-500"><%= conversa.usuario_papel %></p>
      </div>
      <span class="badge badge-<%= conversa.status %> ml-auto"><%= conversa.status_rotulo %></span>
    </div>

    <%- include('partials/aviso', { aviso }) %>
    <div class="flash flash-aviso mb-6" id="aviso-estado" role="status" hidden>
      <%- include('partials/icone', { nome: 'atualizar', classe: 'size-5' }) %>
      <p>O estado desta conversa mudou (alguém assumiu, devolveu ou encerrou). <a href="/conversas/<%= conversa.id %>">Atualizar a página</a></p>
    </div>

    <div class="cartao mb-4 flex flex-wrap items-center gap-3 p-4">
      <p class="mr-auto text-sm text-slate-600"><%= conversa.quem_atende %></p>
      <% if (pode.assumir) { %>
        <form method="POST" action="/conversas/<%= conversa.id %>/assumir">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-primario"><%- include('partials/icone', { nome: 'usuarios' }) %> Assumir atendimento</button>
        </form>
      <% } %>
      <% if (pode.devolver) { %>
        <form method="POST" action="/conversas/<%= conversa.id %>/devolver" data-confirmar="Devolver esta conversa ao bot? O bot volta a responder o usuário." data-confirmar-botao="Devolver ao bot">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn"><%- include('partials/icone', { nome: 'robo' }) %> Devolver ao bot</button>
        </form>
      <% } %>
      <% if (pode.encerrar) { %>
        <form method="POST" action="/conversas/<%= conversa.id %>/encerrar" data-confirmar="Encerrar esta conversa? Se o usuário escrever de novo, começa uma conversa nova." data-confirmar-botao="Encerrar conversa" data-confirmar-perigo="1">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button type="submit" class="btn btn-perigo"><%- include('partials/icone', { nome: 'fechar' }) %> Encerrar</button>
        </form>
      <% } %>
    </div>

    <div class="cartao flex flex-1 flex-col overflow-hidden">
      <p class="border-b border-slate-100 px-5 py-2.5 text-center text-xs text-slate-400">Mensagens novas aparecem sozinhas (a tela consulta o servidor a cada 3 s).</p>

      <div id="mensagens" class="flex flex-1 flex-col gap-3 bg-slate-50/60 px-4 py-5 sm:px-6" data-conversa-id="<%= conversa.id %>" data-estado="<%= conversa.status %>:<%= conversa.atendente_id || '' %>">
        <% mensagens.forEach(m => { %>
          <div class="msg msg-<%= m.remetente %>" data-id="<%= m.id %>">
            <span class="remetente"><%= m.remetente %></span><% if (m.atendente_nome) { %><span class="autor"><%= m.atendente_nome %></span><% } %><span class="hora"><%= m.hora %></span>
            <p><%= m.conteudo %></p>
            <% if (m.feedback) { %><span class="feedback"><%= m.feedback === 'positivo' ? '👍' : '👎' %></span><% } %>
          </div>
        <% }) %>
      </div>

      <% if (pode.responder) { %>
        <div class="sticky bottom-0 border-t border-slate-200 bg-white p-4">
          <form id="form-resposta" class="flex flex-col gap-2" method="POST" action="/api/conversas/<%= conversa.id %>/mensagens">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <div class="flex items-end gap-2">
              <textarea id="texto" name="texto" rows="2" maxlength="<%= limiteMensagem %>" class="campo max-h-56 min-h-12 resize-y" placeholder="Escreva a resposta para <%= conversa.usuario_nome %>…" aria-label="Resposta ao usuário" required></textarea>
              <button type="submit" class="btn btn-primario h-11" id="btn-enviar"><%- include('partials/icone', { nome: 'enviar' }) %><span class="hidden sm:inline">Enviar</span></button>
            </div>
            <p class="dica">Enter envia · Shift+Enter pula de linha · o usuário vê "<%= atendente.nome %>:" antes do texto</p>
            <p class="erro-campo" id="erro-envio" role="alert" hidden></p>
          </form>
        </div>
      <% } %>
    </div>
  </main>

  <script nonce="<%= nonce %>">
    const container = document.getElementById('mensagens');
    const conversaId = container.dataset.conversaId;
    const estadoInicial = container.dataset.estado;
    const avisoEstado = document.getElementById('aviso-estado');

    // ids das mensagens que já estão na tela. O cursor do polling é o maior deles, e a lista evita
    // duplicar uma mensagem caso duas consultas se sobreponham (ex.: o servidor demorou mais de 3s).
    const vistos = new Set(Array.from(container.querySelectorAll('.msg')).map((el) => el.dataset.id));

    function maiorId() {
      let maior = 0;
      vistos.forEach((id) => { if (Number(id) > maior) maior = Number(id); });
      return maior;
    }

    function criarMensagem(m) {
      // Elementos criados via DOM + textContent (nunca innerHTML com texto vindo do banco):
      // mensagens do usuário ou geradas pelo LLM não são confiáveis, e innerHTML deixaria
      // qualquer coisa parecida com HTML/script ser interpretada no navegador do atendente.
      const div = document.createElement('div');
      div.className = `msg msg-${m.remetente}`;
      div.dataset.id = m.id;

      const remetente = document.createElement('span');
      remetente.className = 'remetente';
      remetente.textContent = m.remetente;
      div.appendChild(remetente);

      if (m.atendente_nome) {
        const autor = document.createElement('span');
        autor.className = 'autor';
        autor.textContent = m.atendente_nome;
        div.appendChild(autor);
      }

      const hora = document.createElement('span');
      hora.className = 'hora';
      hora.textContent = m.hora || '';
      div.appendChild(hora);

      const texto = document.createElement('p');
      texto.textContent = m.conteudo;
      div.appendChild(texto);

      if (m.feedback) {
        const fb = document.createElement('span');
        fb.className = 'feedback';
        fb.textContent = m.feedback === 'positivo' ? '👍' : '👎';
        div.appendChild(fb);
      }
      return div;
    }

    async function buscarNovas() {
      try {
        const resp = await fetch(`/api/conversas/${conversaId}/mensagens?desde=${maiorId()}`, { credentials: 'same-origin' });
        if (resp.status === 401) { window.location.href = '/login'; return; } // sessão expirou
        if (!resp.ok) return; // erro passageiro — tenta de novo no próximo ciclo

        const dados = await resp.json();

        // Alguém assumiu / devolveu / encerrou enquanto esta tela estava aberta: os botões daqui ficaram velhos.
        if (dados.estado !== estadoInicial) avisoEstado.hidden = false;

        let adicionou = false;
        dados.mensagens.forEach((m) => {
          const id = String(m.id);
          if (vistos.has(id)) return;
          vistos.add(id);
          container.appendChild(criarMensagem(m));
          adicionou = true;
        });

        if (adicionou) window.scrollTo(0, document.body.scrollHeight);
      } catch (err) {
        console.error('Falha ao buscar novas mensagens:', err);
      }
    }

    // Envio da resposta do atendente (só existe na tela quando ele pode responder).
    const formResposta = document.getElementById('form-resposta');
    if (formResposta) {
      const campo = document.getElementById('texto');
      const botao = document.getElementById('btn-enviar');
      const erro = document.getElementById('erro-envio');
      let enviando = false;

      const mostrarErro = (texto) => { erro.textContent = texto; erro.hidden = !texto; };

      async function enviar() {
        if (enviando) return; // evita enviar duas vezes com um clique duplo
        const texto = campo.value.trim();
        if (!texto) { mostrarErro('Escreva uma mensagem antes de enviar.'); return; }

        enviando = true;
        botao.disabled = true;
        mostrarErro('');
        try {
          const resp = await fetch(formResposta.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ _csrf: formResposta.elements._csrf.value, texto }),
          });
          if (resp.status === 401) { window.location.href = '/login'; return; }

          let dados = null;
          try { dados = await resp.json(); } catch (e) { /* resposta que não é JSON */ }

          if (!resp.ok || !dados || !dados.ok) {
            // O texto fica no campo: o atendente pode corrigir/tentar de novo sem digitar tudo outra vez.
            mostrarErro((dados && dados.erro) || 'Não foi possível enviar (erro inesperado do servidor).');
            return;
          }

          campo.value = '';
          if (dados.aviso) mostrarErro(dados.aviso);
          await buscarNovas(); // mostra a mensagem enviada já, sem esperar o próximo ciclo
        } catch (err) {
          mostrarErro('Falha de rede ao enviar. Confira se o dashboard está no ar e tente de novo.');
        } finally {
          enviando = false;
          botao.disabled = false;
          campo.focus();
        }
      }

      formResposta.addEventListener('submit', (e) => { e.preventDefault(); enviar(); });
      campo.addEventListener('keydown', (e) => {
        // Enter envia; Shift+Enter pula de linha. isComposing: não envia no meio de uma composição (acentos, IME).
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); enviar(); }
      });
    }

    window.scrollTo(0, document.body.scrollHeight); // abre já na mensagem mais recente
    setInterval(buscarNovas, 3000);
  </script>
</body>
</html>
