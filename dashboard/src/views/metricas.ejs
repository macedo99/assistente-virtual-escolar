<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Métricas' }) %>
</head>
<body>
  <%- include('partials/topo', { atendente, ativo: 'metricas' }) %>

  <main class="pagina">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3 print:hidden">
      <div>
        <h1>Métricas</h1>
        <p class="mt-1 text-sm text-slate-500">Volume, satisfação e atendimento humano no período escolhido.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-pequeno" href="/metricas/exportar.csv?tipo=resumo&amp;de=<%= periodo.de %>&amp;ate=<%= periodo.ate %>"><%- include('partials/icone', { nome: 'download', classe: 'size-3.5' }) %> CSV: resumo</a>
        <a class="btn btn-pequeno" href="/metricas/exportar.csv?tipo=conversas&amp;de=<%= periodo.de %>&amp;ate=<%= periodo.ate %>"><%- include('partials/icone', { nome: 'download', classe: 'size-3.5' }) %> CSV: conversas</a>
        <a class="btn btn-pequeno" href="/metricas/exportar.csv?tipo=lacunas&amp;de=<%= periodo.de %>&amp;ate=<%= periodo.ate %>"><%- include('partials/icone', { nome: 'download', classe: 'size-3.5' }) %> CSV: sem resposta</a>
        <a class="btn btn-pequeno" href="/metricas/exportar.csv?tipo=seguranca&amp;de=<%= periodo.de %>&amp;ate=<%= periodo.ate %>"><%- include('partials/icone', { nome: 'download', classe: 'size-3.5' }) %> CSV: segurança</a>
        <button type="button" class="btn btn-pequeno" id="imprimir"><%- include('partials/icone', { nome: 'impressora', classe: 'size-3.5' }) %> Imprimir / PDF</button>
      </div>
    </div>

    <%- include('partials/aviso', { aviso }) %>

    <form class="cartao mb-4 flex flex-wrap items-center gap-3 p-4 print:hidden" method="GET" action="/metricas">
      <div class="flex flex-wrap gap-1.5">
        <% atalhos.forEach((a) => { const ativo = a.de === periodo.de && a.ate === periodo.ate; %>
          <a class="rounded-full px-3 py-1.5 text-xs font-medium ring-1 ring-inset transition <%= ativo ? 'bg-indigo-600 text-white ring-indigo-600' : 'bg-white text-slate-600 ring-slate-300 hover:bg-slate-50' %>" href="/metricas?de=<%= a.de %>&amp;ate=<%= a.ate %>"><%= a.rotulo %></a>
        <% }) %>
      </div>
      <div class="ml-auto flex flex-wrap items-center gap-2 text-sm text-slate-600">
        <label class="flex items-center gap-2">De <input class="campo w-auto py-1.5" type="date" name="de" value="<%= periodo.de %>" required></label>
        <label class="flex items-center gap-2">até <input class="campo w-auto py-1.5" type="date" name="ate" value="<%= periodo.ate %>" required></label>
        <button type="submit" class="btn btn-pequeno btn-primario">Aplicar</button>
      </div>
    </form>

    <h2 class="mb-2 hidden text-xl font-semibold print:block">Métricas do atendimento</h2>
    <p class="mb-6 text-sm text-slate-500">
      Período: <strong class="text-slate-700"><%= fmt.dataBR(periodo.de) %> a <%= fmt.dataBR(periodo.ate) %></strong>
      (<%= r.periodo.dias %> <%= r.periodo.dias === 1 ? 'dia' : 'dias' %>, horário de São Paulo) · gerado em <%= geradoEm %>
    </p>

    <%
      const cartoes = [
        { titulo: 'Volume', icone: 'chat', cor: 'bg-indigo-50 text-indigo-600', numero: fmt.num(r.volume.conversas_ativas), legenda: 'conversas ativas', linhas: [
          ['Mensagens do usuário', fmt.num(r.volume.mensagens_usuario)],
          ['Respostas do bot', fmt.num(r.volume.respostas_bot)],
          ['Usuários ativos', fmt.num(r.volume.usuarios_ativos)],
          ['Conversas novas', fmt.num(r.volume.conversas_novas)],
          ['Usuários novos', fmt.num(r.volume.usuarios_novos)],
        ] },
        { titulo: 'Satisfação', icone: 'check', cor: 'bg-emerald-50 text-emerald-600', numero: fmt.pct(r.satisfacao.percentual), legenda: 'de 👍', linhas: [
          ['👍 positivas', fmt.num(r.satisfacao.positivas)],
          ['👎 negativas', fmt.num(r.satisfacao.negativas)],
          ['Respostas avaliadas', fmt.num(r.satisfacao.avaliadas) + ' de ' + fmt.num(r.satisfacao.respostas_avaliaveis)],
          ['Taxa de avaliação', fmt.pct(r.satisfacao.taxa_avaliacao)],
        ] },
        { titulo: 'Atendimento humano', icone: 'usuarios', cor: 'bg-sky-50 text-sky-600', numero: fmt.pct(r.atendimento.taxa_resolucao_bot), legenda: 'resolvidas pelo bot', linhas: [
          ['Taxa de handoff', fmt.pct(r.atendimento.taxa_handoff) + ' (' + r.atendimento.conversas_com_pedido + ' de ' + r.atendimento.conversas + ')'],
          ['Pedidos de atendente', fmt.num(r.atendimento.pedidos)],
          ['Pedidos atendidos', fmt.num(r.atendimento.pedidos_atendidos)],
          ['Pedidos sem atendimento (voltaram ao bot)', fmt.num(r.atendimento.pedidos_abandonados)],
          ['Pedidos ainda na fila', fmt.num(r.atendimento.pedidos_na_fila)],
        ] },
        { titulo: 'Fila e atendimento', icone: 'relogio', cor: 'bg-amber-50 text-amber-600', numero: fmt.num(r.fila.esperando_agora), legenda: 'esperando agora', linhas: [
          ...(r.fila.mais_antiga_s !== null ? [['Espera mais longa agora', fmt.duracao(r.fila.mais_antiga_s)]] : []),
          ['Em atendimento agora', fmt.num(r.fila.em_atendimento_agora)],
          ['Espera na fila (mediana)', fmt.duracao(r.fila.espera.mediana_s)],
          ['Duração do atendimento (mediana)', fmt.duracao(r.duracao.mediana_s)],
          ['Pedidos atendidos (base da espera)', fmt.num(r.fila.espera.n)],
          ['Atendimentos concluídos (base da duração)', fmt.num(r.duracao.n)],
          ['Atendimentos em andamento', fmt.num(r.duracao.em_andamento)],
        ] },
      ];
    %>
    <div class="mb-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4 print:grid-cols-2">
      <% cartoes.forEach((c) => { %>
        <section class="cartao p-5">
          <div class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg <%= c.cor %>"><%- include('partials/icone', { nome: c.icone }) %></span>
            <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= c.titulo %></h2>
          </div>
          <p class="mt-4 flex items-baseline gap-2"><span class="resumo-numero"><%= c.numero %></span><span class="text-sm text-slate-500"><%= c.legenda %></span></p>
          <dl class="mt-4 divide-y divide-slate-100 text-sm">
            <% c.linhas.forEach(([rotulo, valor]) => { %>
              <div class="flex justify-between gap-4 py-1.5"><dt class="text-slate-500"><%= rotulo %></dt><dd class="whitespace-nowrap text-right font-medium tabular-nums text-slate-800"><%= valor %></dd></div>
            <% }) %>
          </dl>
        </section>
      <% }) %>
    </div>

    <div class="mb-6 grid gap-4 lg:grid-cols-2 print:grid-cols-2">
      <figure class="cartao p-5">
        <figcaption class="mb-3 text-sm font-semibold text-slate-700">Conversas ativas por dia</figcaption>
        <%- graficoConversas %>
      </figure>
      <figure class="cartao p-5">
        <figcaption class="mb-3 text-sm font-semibold text-slate-700">Mensagens do usuário por dia</figcaption>
        <%- graficoMensagens %>
      </figure>
    </div>

    <% const seg = r.seguranca; const maiorMotivo = seg.por_motivo.length ? seg.por_motivo[0].vezes : 1; %>
    <section class="cartao mb-6 overflow-hidden" id="seguranca" aria-labelledby="titulo-seguranca">
      <div class="flex flex-wrap items-start gap-3 border-b border-slate-100 px-5 py-4">
        <span class="grid size-9 place-items-center rounded-lg bg-red-50 text-red-600"><%- include('partials/icone', { nome: 'escudo' }) %></span>
        <div>
          <h2 id="titulo-seguranca" class="text-base font-semibold text-slate-900">Segurança</h2>
          <p class="mt-0.5 text-sm text-slate-500">Tentativas de prompt injection que o bot bloqueou no período (respondeu com o aviso, sem chamar o LLM) e textos da base com ordens escondidas para o bot.</p>
        </div>
      </div>

      <div class="grid divide-y divide-slate-100 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="px-5 py-4">
          <p class="resumo-numero <%= seg.tentativas ? 'text-red-700' : '' %>"><%= fmt.num(seg.tentativas) %></p>
          <p class="text-sm text-slate-500">tentativas bloqueadas no período</p>
        </div>
        <div class="px-5 py-4">
          <p class="resumo-numero"><%= fmt.num(seg.usuarios) %></p>
          <p class="text-sm text-slate-500"><%= seg.usuarios === 1 ? 'usuário diferente' : 'usuários diferentes' %> tentaram</p>
        </div>
        <div class="px-5 py-4">
          <p class="resumo-numero <%= seg.itens_suspeitos.length ? 'text-amber-700' : '' %>"><%= fmt.num(seg.itens_suspeitos.length) %></p>
          <p class="text-sm text-slate-500"><%= seg.itens_suspeitos.length === 1 ? 'item da base' : 'itens da base' %> com trechos suspeitos (agora)</p>
        </div>
      </div>

      <div class="grid gap-6 border-t border-slate-100 px-5 py-5 lg:grid-cols-2">
        <div>
          <h3 class="mb-3 text-sm font-semibold text-slate-700">Por tipo de ataque</h3>
          <% if (seg.por_motivo.length === 0) { %>
            <p class="text-sm text-slate-500">Nenhuma tentativa no período.</p>
          <% } else { %>
            <ul class="space-y-2.5">
              <% seg.por_motivo.forEach((m) => { %>
                <li>
                  <div class="flex justify-between gap-3 text-sm"><span class="text-slate-700"><%= m.rotulo %></span><span class="font-medium tabular-nums text-slate-900"><%= m.vezes %></span></div>
                  <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="mt-1 h-1.5 w-full" aria-hidden="true"><rect width="100" height="6" rx="3" class="fill-slate-100"/><rect width="<%= Math.max(2, Math.round((m.vezes / maiorMotivo) * 100)) %>" height="6" rx="3" class="fill-red-500"/></svg>
                </li>
              <% }) %>
            </ul>
            <p class="dica mt-2">Uma mensagem pode ter mais de um tipo. O tipo é calculado com as regras atuais do detector.</p>
          <% } %>
        </div>
        <div>
          <h3 class="mb-3 text-sm font-semibold text-slate-700">Itens da base para revisar</h3>
          <% if (seg.itens_suspeitos.length === 0) { %>
            <p class="text-sm text-slate-500">Nenhum item da base tem frases que parecem ordens para o bot.</p>
          <% } else { %>
            <ul class="divide-y divide-slate-100 text-sm">
              <% seg.itens_suspeitos.slice(0, 8).forEach((item) => { %>
                <li class="flex items-center justify-between gap-3 py-2">
                  <span class="min-w-0"><span class="block truncate font-medium text-slate-800"><%= item.titulo %></span><span class="block text-xs text-slate-500"><%= item.motivos.join(' · ') %></span></span>
                  <a class="btn btn-pequeno print:hidden" href="/base/<%= item.id %>/editar">Revisar</a>
                </li>
              <% }) %>
            </ul>
            <% if (seg.itens_suspeitos.length > 8) { %><p class="dica mt-2">E mais <%= seg.itens_suspeitos.length - 8 %>.</p><% } %>
          <% } %>
        </div>
      </div>

      <% if (tentativasNaTela.length) { %>
        <div class="overflow-x-auto border-t border-slate-100">
          <table class="tabela">
            <thead><tr><th>Quando</th><th>Usuário</th><th>Mensagem</th><th class="hidden md:table-cell">Tipo</th><th class="text-right print:hidden"><span class="sr-only">Conversa</span></th></tr></thead>
            <tbody>
              <% tentativasNaTela.forEach((t) => { %>
                <tr>
                  <td class="whitespace-nowrap text-slate-500"><%= fmt.dataHora(t.em) %></td>
                  <td class="whitespace-nowrap font-medium text-slate-800"><%= t.usuario %></td>
                  <td class="max-w-md text-slate-700 [overflow-wrap:anywhere]"><%= t.mensagem.length > 160 ? t.mensagem.slice(0, 160) + '…' : t.mensagem %></td>
                  <td class="hidden md:table-cell"><div class="flex flex-wrap gap-1"><% t.motivos.forEach((m) => { %><span class="badge badge-erro"><%= m %></span><% }) %></div></td>
                  <td class="text-right print:hidden"><a class="btn btn-pequeno" href="/conversas/<%= t.conversa_id %>">Abrir</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (seg.lista.length > tentativasNaTela.length) { %>
          <p class="dica border-t border-slate-100 px-5 py-3">Mostrando as <%= tentativasNaTela.length %> mais recentes de <%= seg.lista.length %>. O CSV “segurança” traz todas.</p>
        <% } %>
      <% } %>
    </section>

    <section class="cartao overflow-hidden">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-base font-semibold text-slate-900">Perguntas sem resposta <span class="font-normal text-slate-500">(lacunas na base)</span></h2>
        <p class="mt-1 text-sm text-slate-500">Perguntas que caíram no “não encontrei”, tiveram contexto insuficiente ou receberam 👎. Cadastre a resposta na base para o bot aprender.</p>
      </div>
      <% if (r.lacunas.length === 0) { %>
        <p class="px-5 py-12 text-center text-sm text-slate-500">Nenhuma pergunta sem resposta no período. 🎉</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="tabela">
            <thead><tr><th>Pergunta</th><th class="num">Vezes</th><th class="hidden md:table-cell">Última vez</th><th>Motivo</th><th class="text-right print:hidden">Ação</th></tr></thead>
            <tbody>
              <% lacunasNaTela.forEach((l) => { %>
                <tr>
                  <td class="max-w-md font-medium text-slate-800 [overflow-wrap:anywhere]"><%= l.pergunta %></td>
                  <td class="num"><%= l.vezes %></td>
                  <td class="hidden whitespace-nowrap text-slate-500 md:table-cell"><%= fmt.dataHora(l.ultima) %></td>
                  <td><div class="flex flex-wrap gap-1"><% l.motivos.forEach((m) => { %><span class="badge badge-motivo-<%= m %>"><%= motivos[m] %></span><% }) %></div></td>
                  <td class="text-right print:hidden"><a class="btn btn-pequeno" href="<%= l.href %>"><%- include('partials/icone', { nome: 'mais', classe: 'size-3.5' }) %> Cadastrar na base</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (r.lacunas.length > lacunasNaTela.length) { %>
          <p class="dica border-t border-slate-100 px-5 py-3">Mostrando <%= lacunasNaTela.length %> de <%= r.lacunas.length %> perguntas. O CSV “sem resposta” traz todas.</p>
        <% } %>
      <% } %>
    </section>
  </main>

  <script nonce="<%= nonce %>">
    document.getElementById('imprimir').addEventListener('click', () => window.print());
  </script>
</body>
</html>
