# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Banco da aplicação (usuários, conversas, mensagens, base de conhecimento)
POSTGRES_DB=chatbot

# --- n8n ---
# Chave que protege as credenciais salvas no n8n. Gere uma vez e guarde:
# se ela mudar, as credenciais (ex.: token do Telegram) deixam de abrir.
# Sugestão para gerar: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa

# --- ngrok ---
# Authtoken: painel do ngrok (dashboard.ngrok.com) -> Your Authtoken
NGROK_AUTHTOKEN=seu-authtoken
# Domínio fixo gratuito: painel do ngrok -> Domains. Copie sem "https://".
NGROK_DOMAIN=seu-dominio.ngrok-free.app