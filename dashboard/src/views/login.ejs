<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: 'Entrar' }) %>
</head>
<body class="min-h-screen">
  <main class="grid min-h-screen place-items-center bg-gradient-to-br from-indigo-50 via-slate-50 to-emerald-50 px-4 py-10">
    <div class="w-full max-w-sm">
      <div class="mb-6 flex flex-col items-center text-center">
        <span class="grid size-12 place-items-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20"><%- include('partials/icone', { nome: 'chat', classe: 'size-6' }) %></span>
        <h1 class="mt-4">Dashboard de Atendimento</h1>
        <p class="mt-1 text-sm text-slate-500">Assistente Virtual Escolar</p>
      </div>

      <form class="cartao space-y-4 p-6 sm:p-8" method="POST" action="/login">
        <% if (erro) { %>
          <div class="flash flash-erro" role="alert"><%- include('partials/icone', { nome: 'alerta', classe: 'size-5' }) %><p class="erro"><%= erro %></p></div>
        <% } %>
        <div class="space-y-1.5">
          <label class="rotulo" for="email">E-mail</label>
          <input class="campo" id="email" type="email" name="email" autocomplete="username" required autofocus>
        </div>
        <div class="space-y-1.5">
          <label class="rotulo" for="senha">Senha</label>
          <input class="campo" id="senha" type="password" name="senha" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primario w-full py-2.5">Entrar</button>
      </form>
      <p class="mt-6 text-center text-xs text-slate-400">Acesso restrito a atendentes cadastrados.</p>
    </div>
  </main>
</body>
</html>
