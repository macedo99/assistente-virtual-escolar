<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { titulo: (contagem.aguardando > 0 ? '(' + contagem.aguardando + ') ' : '') + 'Conversas' }) %>
</head>
<body>
  <%- include('partials/topo', { atendente, ativo: 'conversas' }) %>

  <main class="pagina">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1>Conversas</h1>
        <p class="mt-1 text-sm text-slate-500">Conversas ativas no Telegram. Quem pediu um atendente aparece primeiro.</p>
      </div>
      <p class="flex items-center gap-2 text-xs text-slate-500">
        <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span></span>
        Ao vivo · atualiza a cada 5 s · <%= atualizadaEm %>
      </p>
    </div>

    <%- include('partials/aviso', { aviso }) %>

    <div class="mb-6 grid grid-cols-3 gap-3 sm:gap-4">
      <div class="cartao flex items-center gap-4 p-3 sm:p-5 <%= contagem.aguardando > 0 ? 'ring-2 ring-amber-300' : '' %>">
        <span class="hidden size-11 place-items-center rounded-xl sm:grid bg-amber-50 text-amber-600"><%- include('partials/icone', { nome: 'relogio', classe: 'size-5' }) %></span>
        <div><p class="resumo-numero"><%= contagem.aguardando %></p><p class="text-xs text-slate-500 sm:text-sm">aguardando atendente</p></div>
      </div>
      <div class="cartao flex items-center gap-4 p-3 sm:p-5">
        <span class="hidden size-11 place-items-center rounded-xl sm:grid bg-indigo-50 text-indigo-600"><%- include('partials/icone', { nome: 'usuarios', classe: 'size-5' }) %></span>
        <div><p class="resumo-numero"><%= contagem.humano %></p><p class="text-xs text-slate-500 sm:text-sm">em atendimento humano</p></div>
      </div>
      <div class="cartao flex items-center gap-4 p-3 sm:p-5">
        <span class="hidden size-11 place-items-center rounded-xl sm:grid bg-slate-100 text-slate-600"><%- include('partials/icone', { nome: 'robo', classe: 'size-5' }) %></span>
        <div><p class="resumo-numero"><%= contagem.bot %></p><p class="text-xs text-slate-500 sm:text-sm">só com o bot</p></div>
      </div>
    </div>

    <div class="cartao overflow-hidden">
      <% if (conversas.length === 0) { %>
        <div class="flex flex-col items-center px-6 py-16 text-center">
          <span class="grid size-12 place-items-center rounded-full bg-slate-100 text-slate-400"><%- include('partials/icone', { nome: 'chat', classe: 'size-6' }) %></span>
          <p class="mt-4 font-medium text-slate-700">Nenhuma conversa ativa no momento.</p>
          <p class="mt-1 text-sm text-slate-500">Quando alguém escrever para o bot, a conversa aparece aqui.</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="tabela">
            <thead>
              <tr>
                <th>Usuário</th>
                <th>Status</th>
                <th class="hidden md:table-cell">Atendente</th>
                <th class="hidden lg:table-cell">Última mensagem</th>
                <th class="hidden sm:table-cell">Última atividade</th>
                <th><span class="sr-only">Ação</span></th>
              </tr>
            </thead>
            <tbody>
              <% conversas.forEach(c => { %>
                <tr class="<%= c.status === 'aguardando_atendente' ? 'bg-amber-50/50' : '' %>">
                  <td>
                    <p class="font-medium text-slate-900"><%= c.usuario_nome %></p>
                    <p class="text-xs capitalize text-slate-500"><%= c.usuario_papel %></p>
                  </td>
                  <td>
                    <span class="badge badge-<%= c.status %>"><%= c.status_rotulo %></span>
                    <% if (c.espera) { %><p class="mt-1 text-xs font-medium text-amber-700">há <%= c.espera %></p><% } %>
                  </td>
                  <td class="hidden whitespace-nowrap text-slate-600 md:table-cell"><%= c.atendente_exibicao || '—' %></td>
                  <td class="hidden max-w-xs truncate text-slate-600 lg:table-cell"><%= c.ultima_mensagem || '—' %></td>
                  <td class="hidden whitespace-nowrap text-slate-500 sm:table-cell"><%= c.ultima_em_fmt %></td>
                  <td class="text-right">
                    <a class="btn btn-pequeno <%= c.status === 'aguardando_atendente' ? 'btn-primario' : '' %>" href="/conversas/<%= c.id %>"><%= c.status === 'aguardando_atendente' ? 'Atender' : 'Abrir' %></a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    // Recarrega a lista periodicamente pra refletir conversas/mensagens novas.
    // Simples de propósito; dá pra trocar por WebSocket depois se precisar
    // de atualização instantânea de verdade.
    // Se acabou de chegar um recado ("Conversa encerrada..."), espera mais um pouco pra dar tempo de ler.
    setTimeout(() => location.reload(), <%= aviso ? 10000 : 5000 %>);
  </script>
</body>
</html>
