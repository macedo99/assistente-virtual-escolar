# --- postgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=senha-forte
POSTGRES_DB=chatbot

# --- n8n ---
N8N_ENCRYPTION_KEY=chave-aleatoria-longa

# --- ngrok ---
NGROK_AUTHTOKEN=seu-authtoken
NGROK_DOMAIN=seu-dominio.ngrok-free.app

# --- dashboard ---
# Obrigatório, com pelo menos 32 caracteres (o dashboard não sobe sem ele). Gere com: openssl rand -hex 32
SESSION_SECRET=hash-aleatorio
# true quando o dashboard for acessado por HTTPS (cookie só por HTTPS + HSTS). Em http://localhost, deixe false.
COOKIE_SECURE=false
# Vazio = acesso direto. "1" se houver um proxy (nginx, Caddy, túnel) na frente do dashboard.
TRUST_PROXY=
TELEGRAM_BOT_TOKEN=token-telegram

# --- base de conhecimento ---
INGESTAO_TOKEN=hash-aleatorio